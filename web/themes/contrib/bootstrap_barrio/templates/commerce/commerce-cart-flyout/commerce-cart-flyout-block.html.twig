<div class="cart--cart-block">
  <div class="cart-block--summary">
    <a class="cart-block--link__expand" href="<%= url %>" data-counter="<% print(count_text) %>">
      <span class="cart-block--summary__icon"></span>
      <% var countNumber = count_text.replace(/\D/g, ""); %>
      <% if (countNumber > 0) { %>
        <span class="cart-block--summary__count"><%= countNumber %></span>
      <% } %>
    </a>
  </div>
</div>
