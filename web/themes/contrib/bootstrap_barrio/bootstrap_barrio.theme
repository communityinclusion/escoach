/**
 * Implements template_preprocess_table()
 */
function bootstrap_barrio_preprocess_table(&$variables) {
  $variables['table_class'] = DeprecationHelper::backwardsCompatibleCall(\Drupal::VERSION, '11.3.0', fn() => \Drupal::service(ThemeSettingsProvider::class)->getSetting('bootstrap_barrio_table_style'), fn() => theme_get_setting('bootstrap_barrio_table_style'));
  $variables['hover'] = DeprecationHelper::backwardsCompatibleCall(\Drupal::VERSION, '11.3.0', fn() => \Drupal::service(ThemeSettingsProvider::class)->getSetting('bootstrap_barrio_table_hover'), fn() => theme_get_setting('bootstrap_barrio_table_hover'));
  $variables['thead_class'] = DeprecationHelper::backwardsCompatibleCall(\Drupal::VERSION, '11.3.0', fn() => \Drupal::service(ThemeSettingsProvider::class)->getSetting('bootstrap_barrio_table_head'), fn() => theme_get_setting('bootstrap_barrio_table_head'));
}

/**
 * Implements template_preprocess_views_view_table()
 */
function bootstrap_barrio_preprocess_views_view_table(&$variables) {
  $variables['table_class'] = DeprecationHelper::backwardsCompatibleCall(\Drupal::VERSION, '11.3.0', fn() => \Drupal::service(ThemeSettingsProvider::class)->getSetting('bootstrap_barrio_table_style'), fn() => theme_get_setting('bootstrap_barrio_table_style'));
  $variables['hover'] = DeprecationHelper::backwardsCompatibleCall(\Drupal::VERSION, '11.3.0', fn() => \Drupal::service(ThemeSettingsProvider::class)->getSetting('bootstrap_barrio_table_hover'), fn() => theme_get_setting('bootstrap_barrio_table_hover'));
  $variables['thead_class'] = DeprecationHelper::backwardsCompatibleCall(\Drupal::VERSION, '11.3.0', fn() => \Drupal::service(ThemeSettingsProvider::class)->getSetting('bootstrap_barrio_table_head'), fn() => theme_get_setting('bootstrap_barrio_table_head'));
}

